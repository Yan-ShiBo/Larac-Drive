<?xml version="1.0"?>
<sdf version="1.6">
  <model name="cbf_rover_ground">
    <static>true</static>
    <link name="ground">
      <collision name="ground_collision">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>100 100 0.02</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="inherited_ground_visual">
        <geometry>
          <mesh>
            <uri>model://cbf_rover_ground/meshes/ground.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
