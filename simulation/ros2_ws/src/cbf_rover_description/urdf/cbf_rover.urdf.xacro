<?xml version="1.0"?>
<robot name="cbf_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.48"/>
  <xacro:property name="base_width" value="0.38"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="base_mass" value="8.0"/>
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_mass" value="0.6"/>
  <xacro:property name="wheel_separation" value="0.44"/>

  <material name="rover_orange">
    <color rgba="0.92 0.35 0.08 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.08 0.08 0.09 1.0"/>
  </material>
  <material name="sensor_gray">
    <color rgba="0.28 0.30 0.33 1.0"/>
  </material>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}"
        ixy="0" ixz="0"
        iyy="${mass * (x * x + z * z) / 12.0}"
        iyz="0"
        izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"
          ixy="0" ixz="0"
          iyy="${wheel_mass * wheel_radius * wheel_radius / 2.0}"
          iyz="0"
          izz="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} -0.06"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="rover_orange"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${base_mass}"
      x="${base_length}"
      y="${base_width}"
      z="${base_height}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.16"/>
  </joint>

  <xacro:wheel side="left" y="${wheel_separation / 2.0}"/>
  <xacro:wheel side="right" y="${-wheel_separation / 2.0}"/>

  <link name="rear_caster_link">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000064" ixy="0" ixz="0" iyy="0.000064" iyz="0" izz="0.000064"/>
    </inertial>
  </link>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="-0.19 0 -0.11"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.055"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.045" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000152" ixy="0" ixz="0" iyy="0.000152" iyz="0" izz="0.000203"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.10 0 0.09"/>
  </joint>

  <link name="rgbd_camera_link">
    <visual>
      <geometry>
        <box size="0.06 0.13 0.05"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.13 0.05"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="0.18" x="0.06" y="0.13" z="0.05"/>
  </link>
  <joint name="rgbd_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rgbd_camera_link"/>
    <origin xyz="0.20 0 0.07"/>
  </joint>

  <!-- REP-103 optical frame: z forward, x right, y down. -->
  <link name="rgbd_camera_optical_frame"/>
  <joint name="rgbd_camera_optical_joint" type="fixed">
    <parent link="rgbd_camera_link"/>
    <child link="rgbd_camera_optical_frame"/>
    <origin xyz="0.03 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
  </joint>
</robot>
