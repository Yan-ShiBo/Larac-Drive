# Predictable text behavior across Windows development and Linux servers.
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.launch text eol=lf
*.xacro text eol=lf
*.world text eol=lf
*.sdf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Model binaries are intentionally excluded from the source tree. If one is
# ever force-added, keep it binary rather than applying an implicit LFS filter.
*.pt -text
*.pth -text
*.tar -text
*.ckpt -text
*.onnx -text
*.safetensors -text

# Simulation assets.
*.png -text
*.jpg -text
*.jpeg -text
*.dae text eol=lf
*.docx -text
